#!/sbin/openrc-run

description="EasyNode web panel (webSSH/SFTP)"

supervisor=supervise-daemon
command="/usr/local/bin/node"
command_args="index.js"
directory="/opt/easynode"
output_log="/var/log/easynode.log"
error_log="/var/log/easynode.log"
umask=077

depend() {
	need net
}

start_pre() {
	export HOST=0.0.0.0
	export HTTP_PORT="${EASYNODE_HTTP_PORT:-8082}"
	export ENABLE_HTTPS=0
	export COOKIE_SECURE=false
	export DEBUG=0
	export TZ="${TZ:-UTC}"
}
